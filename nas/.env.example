   # 이 파일을 같은 폴더에 kidsnote.env 라는 이름으로 복사한 뒤 값을 채우세요.
   # kidsnote.env 는 NAS 에만 두고 GitHub 에 올리지 마세요. (.gitignore 에 등록됨)

   # 키즈노트 로그인 (부모 계정)
   KIDSNOTE_USERNAME=
   KIDSNOTE_PASSWORD=

   # 2단계 인증을 켜 둔 계정만: 브라우저 쿠키의 sessionid 값 (14일마다 만료)
   KIDSNOTE_SESSION_COOKIE=

   # 아이가 여러 명이면 이름 일부 또는 아이 ID. 한 명이면 비워도 됨
   KIDSNOTE_CHILD_NAME=
   KIDSNOTE_CHILD_ID=

   # HA '불러오기' 버튼용 비밀키. 아무 긴 문자열(영문+숫자 32자 이상 권장)
   # HA secrets.yaml 의 kidsnote_run_key 와 똑같이 맞춰야 합니다.
   KIDSNOTE_RUN_KEY=

   # 매일 자동 수집 시각 (한국시간)
   RUN_AT=18:00

   # 키즈노트 요청 사이 간격(초). 너무 줄이지 마세요.
   REQUEST_DELAY=1.0

   # 최근 며칠치 글은 매번 다시 확인(수정/댓글 반영)
   REFRESH_DAYS=7

   # 처음 켤 때 자동 백필: auto(성공 기록 없을 때만) / true / false
   RUN_ON_START=auto

   # 대시보드 사진 한 페이지 장수 (HA 쪽 사진 칸 수와 같아야 함)
   PHOTOS_PER_PAGE=12

   # 공지/앨범/식단 백업 여부
   BACKUP_NOTICES=true
   BACKUP_ALBUMS=true
   BACKUP_MENUS=true
